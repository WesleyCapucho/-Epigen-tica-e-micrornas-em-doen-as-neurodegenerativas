__pycache__/
*.pyc
.venv/
venv/

# EN | Intermediate pipeline outputs of the bibliometric layer, regenerable by
#      scripts/01 and scripts/02 from the committed raw data.
# PT | Saidas intermediarias da camada bibliometrica, regeneraveis pelos
